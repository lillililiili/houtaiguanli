# 放入现有 Nginx http {} 中，修改两处物理路径。无需高德代理、地图后端或数据库。
server {
    listen 80;
    server_name _;
    root /srv/dongying/dist;
    index index.html;

    location = /map-config.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }
    location = /map-data/control/map-config.json {
        alias /srv/map-data/control/map-config.json;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type application/json;
        limit_except GET { deny all; }
    }
    location ^~ /map-data/ {
        alias /srv/map-data/;
        autoindex off;
        disable_symlinks on;
        gzip off;
        max_ranges 1;
        etag on;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        default_type application/octet-stream;
        types {
            application/json json;
            application/vnd.pmtiles pmtiles;
            application/x-protobuf pbf;
            image/png png;
            font/otf otf;
            text/plain txt;
        }
        limit_except GET { deny all; }
        # 缺失资源保持 404，不能重写到 index.html；静态模块直接处理 Range。
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
