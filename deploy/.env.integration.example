# 复制为 deploy/.env.integration 后再填写。不要提交真实值。
# 必须填写共享服务器的内网或 VPN 地址，禁止使用 0.0.0.0 暴露到公网。
INTEGRATION_DB_BIND_ADDRESS=127.0.0.1
INTEGRATION_DB_PORT=5432
INTEGRATION_DB_NAME=uav_integration
INTEGRATION_DB_USER=uav_integration
INTEGRATION_DB_PASSWORD=replace-with-a-strong-password

# 下列值供首次启动 integration 后端时导入，不会被数据库 Compose 使用。
# 首次创建成功后把开关改回 false，并从运行环境删除初始化密码。
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_SUPER_ADMIN_ACCOUNT=replace-super-admin-account
APP_SUPER_ADMIN_NAME=replace-super-admin-name
APP_SUPER_ADMIN_PASSWORD=replace-with-an-independent-strong-password
